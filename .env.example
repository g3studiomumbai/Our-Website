# The site's own address, used for the canonical URL, og:url and og:image.
#
# Required at build time. Without it those three point at http://localhost:3000, and
# WhatsApp ignores a share image that is not an absolute https URL — which is the one
# thing this page cannot afford, since a shared link is how most of its traffic arrives.
#
# Copy this file to .env.production.local (or set the variable in the host's build
# settings) and fill in the real domain, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com
