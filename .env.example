# Settings the site reads at build time. Put them in Vercel → Project → Settings →
# Environment Variables (Production), then redeploy. Nothing secret belongs in git;
# .env.production holds only the public site address. See UPDATING.md.

# The live address, no trailing slash. Already set in .env.production; set it here or in
# Vercel only to override it, e.g. once the studio has its own domain.
NEXT_PUBLIC_SITE_URL=https://g3-website-pi.vercel.app

# Meta Pixel / dataset ID, from Events Manager. Turns on the Pixel and the events.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token, from Events Manager → Settings → Conversions API.
# Secret: Vercel only, never in a file in git. Turns on the server half.
META_CAPI_TOKEN=
# While checking in Events Manager → Test events. Remove when done.
META_TEST_EVENT_CODE=
# Graph API version for the Conversions API. Change only when Meta retires this one.
META_GRAPH_VERSION=v24.0

# Ownership checks. Paste only the code, not the whole <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
